# ========================================================
# Tele-Nutrition Platform — Root Production Environment
# ========================================================

# PostgreSQL Database Configuration
POSTGRES_USER=telenutrition_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=telenutrition_prod

# Production JWT Secret (must be a 256-bit+ cryptographically random string)
JWT_SECRET=replace_with_openssl_rand_base64_64_secret_key

# Public Domain & CORS Origins
CLIENT_ORIGIN=https://telenutrition.yourhospital.org
VITE_API_URL=https://api.telenutrition.yourhospital.org/api

# Hospital EHR Integration Gateway (HL7 FHIR endpoint)
EHR_BASE_URL=https://fhir.yourhospital.org/r4
