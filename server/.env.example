# ========================================================
# Tele-Nutrition API Server — Environment Variables
# ========================================================

PORT=5000
NODE_ENV=production

# Production PostgreSQL Database Connection URL:
DATABASE_URL="postgresql://telenutrition_admin:replace_with_db_password@postgres:5432/telenutrition_prod?schema=public"

# Mandatory 256-bit cryptographically secure JWT signing key:
JWT_SECRET=replace_with_openssl_rand_base64_64_secret_key

# Strict CORS Whitelist (comma-separated if multiple):
CLIENT_ORIGIN=https://telenutrition.yourhospital.org

# Hospital FHIR EHR Endpoint:
EHR_BASE_URL=https://fhir.yourhospital.org/r4
