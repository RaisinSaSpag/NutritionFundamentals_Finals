{
  "name": "tele-nutrition-database",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --schema=prisma/schema.prisma && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
